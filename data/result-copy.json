  "features": [
    {
      "id": "recognition.high",
      "key": "recognition",
      "side": "high",
      "role": "risk",
      "theme": "attraction",
      "paths": [
        "B"
      ],
      "text": "被理解、被肯定时，你容易对这个人更有好感。",
      "summary": "被理解和肯定的感觉，容易让你更愿意靠近对方。"
    },
    {
      "id": "needed.high",
      "key": "needed",
      "side": "high",
      "role": "risk",
      "theme": "attraction",
      "paths": [
        "B"
      ],
      "text": "对方很需要你时，你容易想多陪陪对方，多付出一些。",
      "summary": "被需要时，你容易把更多心意放进这段关系。"
    },
    {
      "id": "specialness.high",
      "key": "specialness",
      "side": "high",
      "role": "risk",
      "theme": "attraction",
      "paths": [
        "B"
      ],
      "text": "被特别对待时，你容易觉得这段关系很不一样。",
      "summary": "对方特别的关注，容易让你把这段感情看得更重。"
    },
    {
      "id": "scarcity.high",
      "key": "scarcity",
      "side": "high",
      "role": "risk",
      "theme": "attraction",
      "paths": [
        "B"
      ],
      "text": "你容易担心，错过这段关系，就遇不到更合适的人。",
      "summary": "想到可能错过合适的人，你容易更留恋眼前的感情。"
    },
    {
      "id": "rationalization.high",
      "key": "rationalization",
      "side": "high",
      "role": "risk",
      "theme": "rationalization",
      "paths": [
        "C"
      ],
      "text": "面对让你不舒服的表现，你可能先替对方找理由。",
      "summary": "遇到让你失望的表现，你容易先相信对方有自己的难处。"
    },
    {
      "id": "calibration.high",
      "key": "calibration",
      "side": "high",
      "role": "protection",
      "theme": "judgment",
      "paths": [
        "C",
        "D"
      ],
      "text": "你会按关系的实际进展，调整自己的期待。",
      "summary": "你对感情的期待，通常会跟着实际相处慢慢调整。"
    },
    {
      "id": "calibration.low",
      "key": "calibration",
      "side": "low",
      "role": "risk",
      "theme": "judgment",
      "paths": [
        "C",
        "D"
      ],
      "text": "关系已经变了，你可能还保留着原来的期待。",
      "summary": "关系的变化，有时不容易改变你心里原有的期待。"
    },
    {
      "id": "evidence.high",
      "key": "evidence",
      "side": "high",
      "role": "protection",
      "theme": "judgment",
      "paths": [
        "C",
        "D"
      ],
      "text": "比起承诺，你更看重对方有没有真的做到。",
      "summary": "对方能不能说到做到，是你建立信任的重要依据。"
    },
    {
      "id": "evidence.low",
      "key": "evidence",
      "side": "low",
      "role": "risk",
      "theme": "judgment",
      "paths": [
        "C",
        "D"
      ],
      "text": "你可能更看重承诺本身，较少留意对方实际做了什么。",
      "summary": "对方许下的承诺，有时比实际表现更容易让你安心。"
    },
    {
      "id": "manipulation.high",
      "key": "manipulation",
      "side": "high",
      "role": "protection",
      "theme": "judgment",
      "paths": [
        "C",
        "D"
      ],
      "text": "对方在施压，或者把责任推给你时，你较能察觉。",
      "summary": "面对让人为难的相处方式，你通常能看出不合理的地方。"
    },
    {
      "id": "manipulation.low",
      "key": "manipulation",
      "side": "low",
      "role": "risk",
      "theme": "judgment",
      "paths": [
        "C",
        "D"
      ],
      "text": "对方施压或推卸责任时，你可能不容易察觉。",
      "summary": "面对对方的要求，你有时不容易分清自己是否受到了施压。"
    },
    {
      "id": "boundaries.high",
      "key": "boundaries",
      "side": "high",
      "role": "protection",
      "theme": "boundaries",
      "paths": [
        "D"
      ],
      "text": "即使在意对方，你也能拒绝不合理的要求。",
      "summary": "认真喜欢一个人时，你通常也能守住自己的接受范围。"
    },
    {
      "id": "boundaries.low",
      "key": "boundaries",
      "side": "low",
      "role": "risk",
      "theme": "boundaries",
      "paths": [
        "D"
      ],
      "text": "面对对方的要求，你可能心里犹豫，最后还是答应了。",
      "summary": "在意对方时，你有时会答应自己原本不愿意的要求。"
    },
    {
      "id": "stopLoss.high",
      "key": "stopLoss",
      "side": "high",
      "role": "protection",
      "theme": "stopLoss",
      "paths": [
        "E"
      ],
      "text": "确认关系不合适后，你较能停下来，不再继续付出。",
      "summary": "确定关系不合适后，你较能停止继续付出。"
    },
    {
      "id": "stopLoss.low",
      "key": "stopLoss",
      "side": "low",
      "role": "risk",
      "theme": "stopLoss",
      "paths": [
        "E"
      ],
      "text": "即使知道关系不合适，你也可能难以放下。",
      "summary": "即使知道关系不合适，舍不得的感觉也可能让你迟迟难以停下。"
    },
