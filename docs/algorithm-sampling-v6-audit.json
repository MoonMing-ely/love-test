  "profileDefinitions": [
    {
      "id": "steady",
      "name": "温暖且稳健",
      "expectation": "较低",
      "brief": "会心动、有善意，但看重长期行为，能拒绝、停止追求；允许有限观察期。"
    },
    {
      "id": "sensitive",
      "name": "容易被打动但守得住",
      "expectation": "较低",
      "brief": "很重视理解、细节和被需要；涉及不合理要求、反复伤害、明确拒绝时仍守住界限。"
    },
    {
      "id": "accommodating",
      "name": "偶尔迁就但大体能守界",
      "expectation": "中间",
      "brief": "看得出问题，怕让人失望时偶尔让步；明确越界仍拒绝，没有长期持续不对等投入。"
    },
    {
      "id": "entangled",
      "name": "内心纠缠但实际能停止",
      "expectation": "较低至中间",
      "brief": "容易把心疼、帮助与感情混在一起，但实际会拒绝，分开后不恢复陪伴，明确拒绝后会减少联系。"
    },
    {
      "id": "exitdelay",
      "name": "知道不合适但迟迟不停",
      "expectation": "中间至较高",
      "brief": "知道不对等，也能拒绝具体要求；因投入和不舍持续主动、迟迟不结束关系。"
    },
    {
      "id": "fasttrust",
      "name": "初期轻信但会核实止损",
      "expectation": "中间",
      "brief": "初期容易因倾诉和亲近增加信任，也容易把付出当升级；反复异常后仍核实、调整和停止。"
    },
    {
      "id": "rationalize",
      "name": "回避问题但实际边界尚在",
      "expectation": "中间",
      "brief": "经常替冷淡和失望找理由，回避问清关系；不随便牺牲自己的事，明确拒绝后能停止追求。"
    },
    {
      "id": "confident",
      "name": "行为稳健但过度自信",
      "expectation": "较低",
      "brief": "实际选择与稳健者相同，但笃定自己不会上头，不太接受自己可能判断失误。"
    },
    {
      "id": "repeatedgive",
      "name": "清醒但反复牺牲自己",
      "expectation": "中间至较高",
      "brief": "能识别操纵和言行不一，却经常因为怕失望牺牲时间和界限，维持不对等投入。"
    },
    {
      "id": "middling",
      "name": "多处偶尔动摇且会纠正",
      "expectation": "中间",
      "brief": "有时高估关系、听道歉就心软，也偶尔多帮忙；仍接受提醒，多数情境下保留边界和停止条件。"
    },
    {
      "id": "vulnerable",
      "name": "多方面持续失守",
      "expectation": "较高",
      "brief": "容易快速投入、忽略长期异常、接受内疚施压，并且难停止和接受外部提醒。"
    },
    {
      "id": "calmcoldgive",
      "name": "不易心动但持续迁就",
      "expectation": "中间至较高",
      "brief": "不因认可、独特或被需要而上头，但害怕冲突，实际持续答应不合理要求、过度投入。"
    },
    {
      "id": "timepressure",
      "name": "主要在帮忙和时间上失守",
      "expectation": "中间",
      "brief": "关系判断基本清楚，身体界限和关系承诺能拒绝；但反复因人情牺牲时间，明知耽误自己也帮忙。"
    },
    {
      "id": "mentalstrong",
      "name": "心理高度纠缠但停止行为明确",
      "expectation": "较低至中间",
      "brief": "心理上很难把原谅、喜欢、帮助和信任分开，也常把付出理解为升级；但会拒绝具体要求，不接受长期不对等投入，分开后不恢复陪伴。"
    },
    {
      "id": "blindtrust",
      "name": "容易轻信并忽略长期反常",
      "expectation": "中间至较高",
      "brief": "容易托付、听道歉就恢复信任，曾反复忽视言行不一；但身体和时间界限能拒绝，明确被拒绝后能停止。"
    },
    {
      "id": "pressurecommit",
      "name": "心软答应但能事后停止",
      "expectation": "中间",
      "brief": "容易因怕失望答应承诺或请求、少表达自身不适，之后会重新审视，长期关系不对等时能停。"
    },
